# =============================================================================
# PRESSING PRO — configuration complète
# =============================================================================
# 1. Copier ce fichier :        cp .env.example .env
# 2. Remplir les valeurs ci-dessous.
# 3. Lancer :                   npm run setup
#
# `.env` ne doit JAMAIS être commité (déjà couvert par .gitignore).
#
# Rappel : seules les variables préfixées VITE_ sont envoyées au navigateur.
# Tout le reste n'est lu que par `npm run setup` (côté machine) puis poussé
# dans les secrets Supabase. Ne mettez donc jamais de secret derrière VITE_.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SUPABASE — côté navigateur (valeurs PUBLIQUES, embarquées dans le bundle)
# -----------------------------------------------------------------------------
# Project Settings → API → Project URL / anon public key
VITE_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemple.exemple


# -----------------------------------------------------------------------------
# 2. SUPABASE — provisioning (SECRET, lu uniquement par `npm run setup`)
# -----------------------------------------------------------------------------
# Jeton personnel : Account → Access Tokens → Generate new token (sbp_…)
# Sert à lier le projet et à déployer les Edge Functions.
SUPABASE_ACCESS_TOKEN=sbp_remplacez_moi

# Project Settings → Database → Database password
# (celui choisi à la création du projet ; il est possible de le réinitialiser)
SUPABASE_DB_PASSWORD=remplacez_moi

# Project Settings → API → service_role key (SECRET : contourne la RLS)
# Sert une seule fois, à la création du pressing et du compte propriétaire.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemple.exemple

# Adresse publique de l'application, SANS barre finale.
# - en local      : http://localhost:5173
# - en production : https://pressing-pro.vercel.app
# C'est l'adresse vers laquelle CinetPay renvoie le client après paiement.
APP_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# 3. CINETPAY — Mobile Money (facultatif : sans ces valeurs, les commandes
#    fonctionnent mais le bouton « Payer par Mobile Money » reste inopérant)
# -----------------------------------------------------------------------------
# Back-office CinetPay → Intégration → clés API.
# NE JAMAIS préfixer ces variables par VITE_.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Recommandée : sans elle, le webhook n'est pas authentifié par HMAC (le statut
# est tout de même reconfirmé auprès de l'API CinetPay).
CINETPAY_SECRET_KEY=
# Laisser vide en production (https://api-checkout.cinetpay.com par défaut).
CINETPAY_BASE_URL=

# « production » (défaut) exige CINETPAY_SECRET_KEY : le webhook refuse alors
# toute notification non signée. « development » autorise un webhook sans HMAC,
# uniquement pour les essais locaux.
APP_ENV=production


# -----------------------------------------------------------------------------
# 4. COMPTE INITIAL — créé par `npm run setup` (facultatif, mais recommandé)
# -----------------------------------------------------------------------------
# Ces identifiants servent à vous connecter à l'application. Choisissez un mot
# de passe solide : il est envoyé tel quel à Supabase Auth (6 caractères min.).
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Nom du pressing créé au premier lancement (ignoré s'il existe déjà).
SEED_TENANT_NAME=Pressing Cocody
SEED_TENANT_PHONE=+2250700000000

# Supervision de la plateforme (palier 4, facultatif).
# `true` inscrit ce compte dans `platform_admins` : il voit alors la console
# /supervision (tous les pressings, abonnements, support). À ne laisser à
# `true` que sur le compte de l'éditeur — jamais sur celui d'un client.
PLATFORM_ADMIN=false


# -----------------------------------------------------------------------------
# 5. DÉVELOPPEMENT UNIQUEMENT
# -----------------------------------------------------------------------------
# Sans aucun projet Supabase configuré, l'application bascule en mode
# démonstration et demande l'identifiant d'un pressing. Cette variable
# pré-remplit le champ (UUID de supabase/seed.sql).
# VITE_DEMO_TENANT_ID=11111111-1111-4111-8111-111111111111
