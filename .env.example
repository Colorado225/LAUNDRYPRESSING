# =============================================================================
# VARIABLES D'ENVIRONNEMENT — Pressing Pro
# Copier ce fichier vers `.env` puis renseigner les valeurs réelles.
# `.env` ne doit JAMAIS être commité.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE — côté navigateur (valeurs publiques)
# -----------------------------------------------------------------------------
# Toute variable préfixée `VITE_` est EMBARQUÉE dans le bundle JavaScript :
# elle est donc visible par n'importe quel utilisateur. Ne jamais y mettre
# de secret (service_role, clé API CinetPay, etc.).
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# (Optionnel, développement) Pressing utilisé pour tester le mode offline-first
# avant la mise en place de la connexion (phase 5). Utilisez l'UUID d'un
# pressing créé par supabase/seed.sql.
# VITE_DEMO_TENANT_ID=11111111-1111-4111-8111-111111111111


# =============================================================================
# 2. SECRETS SERVEUR — à configurer dans Supabase, PAS dans ce fichier
#    (Dashboard > Edge Functions > Secrets, ou `supabase secrets set ...`)
# =============================================================================

# --- CinetPay (API v2) ---
# CINETPAY_API_KEY=...
# CINETPAY_SITE_ID=...
# CINETPAY_SECRET_KEY=...          # sert à vérifier la signature du webhook
# CINETPAY_NOTIFY_URL=https://<projet>.supabase.co/functions/v1/cinetpay-webhook
# CINETPAY_RETURN_URL=https://<domaine>/paiement/retour

# --- Supabase (réservé aux Edge Functions) ---
# SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...     # contourne la RLS : ne jamais exposer côté client

# =============================================================================
# 3. SUPABASE CLI (local) — pas nécessaire si vous utilisez un projet cloud
# =============================================================================
# Supabase CLI lit ces variables depuis l'environnement du shell, pas depuis .env.
