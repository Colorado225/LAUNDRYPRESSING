{
  "name": "laundry-pressing",
  "private": true,
  "version": "0.0.0",
  "description": "SaaS multi-tenant de gestion de pressing (Côte d'Ivoire) — MVP offline-first",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check",
    "setup:dry": "node scripts/setup.mjs --dry-run",
    "sql:verify": "bash scripts/sql-verify.sh",
    "db:etat": "node scripts/db.mjs etat",
    "db:push": "node scripts/db.mjs push",
    "db:verifier": "node scripts/db.mjs verifier",
    "migrations:recuperer": "node scripts/migrations-distantes.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "recette": "node scripts/recette.mjs",
    "simulateur": "node scripts/cinetpay-simule.mjs",
    "deploy:fonctions": "node scripts/deploy-fonctions.mjs",
    "e2e": "playwright test",
    "e2e:demo": "playwright test --project=demo --project=demo-mobile",
    "e2e:reel": "playwright test --project=reel",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "html5-qrcode": "2.3.8",
    "lucide-react": "^1.11.0",
    "qrcode": "1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.2",
    "vite-plugin-pwa": "2.0.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.4.0",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.4",
    "vitest": "^5.0.5"
  }
}
