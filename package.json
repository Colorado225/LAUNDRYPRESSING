{
  "name": "laundry-pressing",
  "private": true,
  "version": "0.0.0",
  "description": "SaaS multi-tenant de gestion de pressing (Côte d'Ivoire) — MVP offline-first",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check",
    "setup:dry": "node scripts/setup.mjs --dry-run",
    "sql:verify": "bash scripts/sql-verify.sh",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "^4.2.2",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "html5-qrcode": "2.3.8",
    "lucide-react": "^1.11.0",
    "qrcode": "1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.14.0",
    "tailwindcss": "^4.2.2",
    "vite-plugin-pwa": "2.0.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "26.6.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.4.0",
    "jsdom": "^30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.4",
    "vitest": "^5.0.5"
  }
}
